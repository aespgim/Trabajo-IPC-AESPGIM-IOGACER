<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="560.0" prefWidth="480.0" styleClass="root-pane"
            xmlns="[javafx.com](http://javafx.com/javafx/25)"
            xmlns:fx="[javafx.com](http://javafx.com/fxml/1)"
            fx:controller="controlador.RegistroControlador">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
    <VBox alignment="CENTER" spacing="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <VBox styleClass="auth-card" alignment="CENTER" spacing="16.0"
              maxWidth="380.0">
            <!-- Header -->
            <HBox alignment="CENTER" spacing="10.0">
                <Label text="◈" styleClass="brand-icon" />
                <Label text="ApexRun" styleClass="brand-title" />
            </HBox>
            <Region styleClass="accent-divider" prefHeight="1.5" maxWidth="300.0" />
            <Label text="Crear Cuenta" styleClass="auth-title" />
            <!-- Nickname -->
            <VBox styleClass="field-group" spacing="4.0" maxWidth="320.0" prefWidth="320.0">
                <TextField fx:id="txtNickname"
                           prefHeight="44.0"
                           promptText="Nombre de usuario"
                           styleClass="input-field" />
                <Label fx:id="lblErrorNickname" styleClass="error-label"
                       text="Entre 6 y 15 caracteres (letras, números, - o _)."
                       visible="false" />
            </VBox>
            <!-- Email -->
            <VBox styleClass="field-group" spacing="4.0" maxWidth="320.0" prefWidth="320.0">
                <TextField fx:id="txtEmail"
                           prefHeight="44.0"
                           promptText="Correo electrónico"
                           styleClass="input-field" />
                <Label fx:id="lblErrorEmail" styleClass="error-label"
                       text="Formato de email incorrecto."
                       visible="false" />
            </VBox>
            <!-- Password -->
            <VBox styleClass="field-group" spacing="4.0" maxWidth="320.0" prefWidth="320.0">
                <PasswordField fx:id="txtPassword"
                               prefHeight="44.0"
                               promptText="Contraseña"
                               styleClass="input-field" />
                <Label fx:id="lblErrorPassword" styleClass="error-label"
                       text="De 8 a 20 caracteres (mayúscula, minúscula, número y símbolo)."
                       visible="false" />
            </VBox>
            <!-- Fecha -->
            <VBox styleClass="field-group" spacing="4.0" maxWidth="320.0" prefWidth="320.0">
                <DatePicker fx:id="dpFechaNacimiento"
                            maxWidth="1.7976931348623157E308"
                            prefHeight="44.0"
                            promptText="Fecha de nacimiento"
                            styleClass="input-field" />
                <Label fx:id="lblErrorFecha" styleClass="error-label"
                       text="Debes ser mayor de 12 años."
                       visible="false" />
            </VBox>
            <!-- Error general -->
            <Label fx:id="lblErrorGeneral" styleClass="error-label"
                   text="" visible="false" />
            <!-- Buttons -->
            <HBox spacing="12.0" maxWidth="320.0" prefWidth="320.0">
                <VBox.margin><Insets top="6.0" /></VBox.margin>
                <Button fx:id="btnCancelar"
                        text="Cancelar"
                        onAction="#handleCancelar"
                        styleClass="btn-secondary"
                        maxWidth="1.7976931348623157E308"
                        prefHeight="44.0"
                        HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAceptar"
                        text="Crear cuenta"
                        onAction="#handleAceptar"
                        styleClass="btn-primary"
                        maxWidth="1.7976931348623157E308"
                        prefHeight="44.0"
                        HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>